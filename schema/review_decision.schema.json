{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantrobs/fandea/schema/ReviewDecision",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "skill_id": {
      "title": "Skill Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "approved",
        "rejected",
        "changes_requested"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reviewer": {
      "title": "Reviewer",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "golden_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Golden Report Ref"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "policy": {
      "default": "human_default",
      "title": "Policy",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "skill_id",
    "version",
    "run_id",
    "outcome",
    "reviewer",
    "decided_at"
  ],
  "title": "ReviewDecision",
  "type": "object"
}

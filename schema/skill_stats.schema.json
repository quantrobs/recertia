{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantrobs/fandea/schema/SkillStats",
  "$defs": {
    "Contribution": {
      "additionalProperties": false,
      "description": "Per-skill lift over the control baseline; the retirement input (ADR-0006, specs \u00a724.2).\n\nScored from required non-``judge`` criteria only: a false-pass-biased model judge must not\nbe able to disable contribution-based retirement (``references.md`` \u00a71.8).",
      "properties": {
        "applications": {
          "default": 0,
          "minimum": 0,
          "title": "Applications",
          "type": "integer"
        },
        "successes": {
          "default": 0,
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "baseline_success": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Success"
        },
        "interval_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Low"
        },
        "interval_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval High"
        },
        "last_evaluated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Evaluated At"
        }
      },
      "title": "Contribution",
      "type": "object"
    },
    "Trust": {
      "additionalProperties": false,
      "description": "Derived, never authored. A ratio is not causal evidence (specs \u00a72.1, \u00a77.1).",
      "properties": {
        "applications": {
          "default": 0,
          "minimum": 0,
          "title": "Applications",
          "type": "integer"
        },
        "successes": {
          "default": 0,
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "last_used_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Used At"
        },
        "lift_estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lift Estimate"
        },
        "lift_samples": {
          "default": 0,
          "minimum": 0,
          "title": "Lift Samples",
          "type": "integer"
        },
        "decayed_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decayed Score"
        }
      },
      "title": "Trust",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "skill_id": {
      "title": "Skill Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "trust": {
      "$ref": "#/$defs/Trust",
      "default": {
        "applications": 0,
        "successes": 0,
        "last_used_at": null,
        "lift_estimate": null,
        "lift_samples": 0,
        "decayed_score": null
      }
    },
    "contribution": {
      "$ref": "#/$defs/Contribution",
      "default": {
        "applications": 0,
        "successes": 0,
        "baseline_success": null,
        "interval_low": null,
        "interval_high": null,
        "last_evaluated_at": null
      }
    }
  },
  "required": [
    "skill_id",
    "version"
  ],
  "title": "SkillStats",
  "type": "object"
}

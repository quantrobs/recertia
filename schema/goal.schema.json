{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantrobs/fandea/schema/Goal",
  "title": "Goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["desired"],
  "properties": {
    "goal_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
    "desired": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/DesiredState"}
    },
    "constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/Constraint"},
      "default": []
    },
    "context": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "description": "Optional natural-language context / human label. Never the sole success contract."
    },
    "task_class": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
    "preferences": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "default": {}
    },
    "strategy_hint": {
      "anyOf": [
        {"type": "string", "enum": ["abstain", "portfolio", "decomposition"]},
        {"type": "null"}
      ],
      "default": null
    }
  },
  "$defs": {
    "DesiredState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string"},
        "kind": {
          "type": "string",
          "enum": ["file_exists", "file_contains", "command", "assertion", "schema", "metric", "judge"]
        },
        "path": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "pattern": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "run": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "expect_exit": {"type": "integer", "default": 0},
        "expr": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "target": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "schema_ref": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "metric": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "op": {
          "anyOf": [
            {"type": "string", "enum": ["lt", "le", "gt", "ge", "eq"]},
            {"type": "null"}
          ],
          "default": null
        },
        "threshold": {"anyOf": [{"type": "number"}, {"type": "null"}], "default": null},
        "rubric": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null},
        "weight": {"type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 300}
      }
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value"],
      "properties": {
        "id": {"type": "string"},
        "kind": {
          "type": "string",
          "enum": ["must_not_modify", "must_pass_command", "budget_ceiling", "no_external_effects"]
        },
        "value": {
          "anyOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "weight": {"type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0}
      }
    }
  }
}

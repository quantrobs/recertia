{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantrobs/fandea/schema/skill.schema.json",
  "title": "Fandea Skill Version",
  "description": "A single immutable version of a reusable skill in the Fandea skill library. Versions are never edited in place; evolution produces a new version with 'supersedes' set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "lifecycle",
    "title",
    "intent",
    "task_class",
    "steps",
    "success_criteria",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug identifying the skill across versions."
    },
    "version": { "type": "integer", "minimum": 1 },
    "supersedes": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Version this one replaces. Null for the first version."
    },
    "lifecycle": {
      "enum": ["draft", "candidate", "shadow", "approved", "needs_recert", "deprecated", "quarantined"]
    },
    "scope": {
      "enum": ["run", "project", "org", "global"],
      "default": "project",
      "description": "Cross-scope promotion requires review and redaction."
    },
    "uses": {
      "type": "array",
      "description": "Pinned child skills invoked as steps. The uses graph must be acyclic with depth <= 3; quarantining a child sets pinning parents to needs_recert.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "version"],
        "properties": {
          "skill_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "version": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "title": { "type": "string", "minLength": 8, "maxLength": 120 },
    "intent": {
      "type": "string",
      "minLength": 20,
      "description": "What this skill accomplishes. Embedded for retrieval, so it should read like a task description."
    },
    "task_class": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Groups skills for eval sets, metrics and promotion policy."
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "type": { "enum": ["string", "number", "boolean", "path", "enum", "json"] },
          "required": { "type": "boolean", "default": true },
          "default": {},
          "enum_values": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "description": "Evaluated by retrieval before the skill is offered. A failing precondition drops the candidate entirely.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["file_exists", "path_glob", "command_succeeds", "env_present", "tool_available"] },
          "value": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "tool": { "type": "string" },
          "intent": { "type": "string", "minLength": 5 },
          "inputs": { "type": "object" },
          "optional": { "type": "boolean", "default": false },
          "loop": {
            "type": "object",
            "additionalProperties": false,
            "required": ["until", "max_iterations"],
            "description": "Bounded step-level repetition. max_iterations is mandatory; unbounded loops are invalid.",
            "properties": {
              "until": { "enum": ["criteria_pass", "no_change", "predicate"] },
              "predicate": { "type": "string" },
              "max_iterations": { "type": "integer", "minimum": 1, "maximum": 10 }
            }
          }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "At least one criterion must have kind != 'judge' for the skill to reach 'approved'. Criteria with weight >= 1.0 are required; lower weights are advisory and surfaced to review.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "kind": { "enum": ["command", "assertion", "schema", "metric", "judge"] },
          "run": { "type": "string" },
          "expect_exit": { "type": "integer", "default": 0 },
          "expr": { "type": "string" },
          "target": { "type": "string" },
          "schema_ref": { "type": "string" },
          "metric": { "type": "string" },
          "op": { "enum": ["lt", "lte", "gt", "gte", "eq"] },
          "threshold": { "type": "number" },
          "rubric": { "type": "string" },
          "timeout_s": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 300 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
          "authored_by": {
            "enum": ["caller", "critic", "distiller", "human"],
            "description": "Criteria proposed by a critic run before solving are independent of the solver; distiller-authored criteria are advisory until reviewed."
          },
          "preregistered": {
            "type": "boolean",
            "default": false,
            "description": "True when this criterion was locked at intake, before solving."
          },
          "sensitivity_proof": {
            "type": "object",
            "additionalProperties": false,
            "required": ["negative_fixture", "rejected", "checked_at"],
            "description": "Evidence that the criterion rejects a known-bad artifact. Without rejected == true the criterion is advisory only.",
            "properties": {
              "negative_fixture": { "type": "string" },
              "rejected": { "type": "boolean" },
              "checked_at": { "type": "string", "format": "date-time" },
              "checked_against": { "type": "string", "description": "Manifest hash of the environment used." }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "command" } } }, "then": { "required": ["run"] } },
          { "if": { "properties": { "kind": { "const": "assertion" } } }, "then": { "required": ["expr"] } },
          { "if": { "properties": { "kind": { "const": "schema" } } }, "then": { "required": ["target", "schema_ref"] } },
          { "if": { "properties": { "kind": { "const": "metric" } } }, "then": { "required": ["metric", "op", "threshold"] } },
          { "if": { "properties": { "kind": { "const": "judge" } } }, "then": { "required": ["rubric"] } }
        ]
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symptom", "response"],
        "properties": {
          "symptom": { "type": "string" },
          "response": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distilled_from_run", "distilled_at"],
      "properties": {
        "distilled_from_run": { "type": "string" },
        "distilled_at": { "type": "string", "format": "date-time" },
        "authored_by": { "type": "string", "description": "Set for hand-authored seed skills." },
        "evolved_because": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "description": "Derived, never authored. score = (successes + 1) / (applications + 2). A ratio is not causal evidence, so lift is reported alongside it.",
      "properties": {
        "applications": { "type": "integer", "minimum": 0 },
        "successes": { "type": "integer", "minimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "last_used_at": { "type": ["string", "null"], "format": "date-time" },
        "lift_estimate": {
          "type": ["number", "null"],
          "description": "First-attempt success in treatment minus control for this skill's task class."
        },
        "lift_samples": { "type": "integer", "minimum": 0 },
        "decayed_score": {
          "type": ["number", "null"],
          "description": "score adjusted for time since last successful application; used for retrieval ranking."
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "description": "What environment and model this version was validated against. Drift in any of these marks the skill needs_recert.",
      "properties": {
        "model_validated_on": { "type": "string" },
        "tool_fingerprint": {
          "type": "object",
          "description": "Tool or runtime name to version, as observed during validation.",
          "additionalProperties": { "type": "string" }
        },
        "golden_set_ref": { "type": ["string", "null"] },
        "last_recertified_at": { "type": ["string", "null"], "format": "date-time" },
        "recert_status": { "enum": ["fresh", "stale", "failed", "never"] }
      }
    },
    "hygiene": {
      "type": "object",
      "additionalProperties": false,
      "description": "Store-time secret and PII scan. A draft failing the scan is rejected, not silently sanitised.",
      "properties": {
        "secret_scan": { "enum": ["passed", "failed", "skipped"] },
        "scanned_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "superseded_by": { "type": ["integer", "null"], "minimum": 1 },
        "reason": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

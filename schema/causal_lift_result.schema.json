{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/recertia/recertia/schema/CausalLiftResult",
  "$defs": {
    "BinomialSample": {
      "additionalProperties": false,
      "properties": {
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "trials": {
          "minimum": 0,
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "successes",
        "trials"
      ],
      "title": "BinomialSample",
      "type": "object"
    },
    "ConfidenceInterval": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "level": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Level",
          "type": "number"
        },
        "method": {
          "default": "newcombe_wilson",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "ConfidenceInterval",
      "type": "object"
    },
    "RunVariance": {
      "additionalProperties": false,
      "description": "Best\u2013worst gap and sample std-dev over independent run (or snapshot) rates.",
      "properties": {
        "n_runs": {
          "minimum": 0,
          "title": "N Runs",
          "type": "integer"
        },
        "std_dev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std Dev"
        },
        "best_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Rate"
        },
        "worst_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worst Rate"
        },
        "best_worst_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Worst Gap"
        }
      },
      "required": [
        "n_runs"
      ],
      "title": "RunVariance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Treatment \u2212 control first-attempt success with a difference CI (specs \u00a719).",
  "properties": {
    "task_class": {
      "title": "Task Class",
      "type": "string"
    },
    "treatment": {
      "$ref": "#/$defs/BinomialSample"
    },
    "control": {
      "$ref": "#/$defs/BinomialSample"
    },
    "estimate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Estimate"
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfidenceInterval"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "established_positive",
        "established_negative",
        "not_established",
        "insufficient_data",
        "low_run_count"
      ],
      "title": "Status",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "window": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window"
    },
    "treatment_variance": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunVariance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "control_variance": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunVariance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lift_variance": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunVariance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "min_independent_runs": {
      "default": 5,
      "minimum": 1,
      "title": "Min Independent Runs",
      "type": "integer"
    },
    "independent_runs": {
      "default": 0,
      "minimum": 0,
      "title": "Independent Runs",
      "type": "integer"
    }
  },
  "required": [
    "task_class",
    "treatment",
    "control",
    "estimate",
    "interval",
    "status"
  ],
  "title": "CausalLiftResult",
  "type": "object"
}
